{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    /* 시딩·조치 소스를 별칭으로 불러온다(vite.config.ts의 resolve.alias와 짝). 의존성은 루트에 한 벌이다(HP-524). */
    "paths": {
      "@seeding/*": ["../../seeding/app/src/*"],
      "@moderation/*": ["../../moderation/app/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

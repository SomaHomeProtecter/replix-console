# 호스팅 빌드(npm run build → docs/moderation/) 프로필 — HP-456.
# 모두 브라우저에 그대로 실리는 공개 값이다(비밀값을 넣지 말 것). 호스팅 빌드에는 LOCAL이 없다.
# 기본 환경은 여기가 아니라 주소가 정한다: console.replix.tv로 처음 열면 PROD(src/environment.ts).
# 아래 기본값은 그 밖의 주소(예: 로컬에서 빌드 결과를 띄울 때)에만 쓰인다 — 잘못 띄워도 운영을 겨누지 않게 DEV.
VITE_DEFAULT_ENVIRONMENT=DEV

VITE_DEV_API_BASE_URL=https://api.replix-dev.site
VITE_DEV_KC_URL=https://auth.replix-dev.site
VITE_DEV_KC_REALM=replix
VITE_DEV_KC_CLIENT_ID=replix-web
VITE_DEV_EXPECTED_AUDIENCE=account
VITE_DEV_EXPECTED_AZP=replix-web

VITE_PROD_API_BASE_URL=https://api.replix.tv
VITE_PROD_KC_URL=https://auth.replix.tv
VITE_PROD_KC_REALM=replix
VITE_PROD_KC_CLIENT_ID=replix-web
VITE_PROD_EXPECTED_AUDIENCE=account
VITE_PROD_EXPECTED_AZP=replix-web

# 모더레이션 대시보드 링크(HP-297). DEV/PROD 선택에 따라 var-namespace=dev|prod가 붙는다.
VITE_GRAFANA_URL=https://grafana.replix-dev.site
